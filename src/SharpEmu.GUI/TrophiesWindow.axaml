<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharpEmu.GUI"
        x:Class="SharpEmu.GUI.TrophiesWindow"
        Width="1120"
        Height="820"
        MinWidth="820"
        MinHeight="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Title="{Binding [Trophies.Title], Source={x:Static local:Localization.Instance}}">
  <Grid Margin="48,36,48,28" RowDefinitions="Auto,*">

    <!-- Header like the console's: the game on the left, its completion and earned cups on the right. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,26">
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <TextBlock x:Name="GameNameText"
                   FontSize="30"
                   FontWeight="Light"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ProgressText"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="13" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
        <StackPanel Spacing="6" Width="170" VerticalAlignment="Center">
          <TextBlock x:Name="PercentText" FontSize="26" HorizontalAlignment="Right" />
          <ProgressBar x:Name="ProgressBar"
                       Minimum="0"
                       Maximum="100"
                       Height="4"
                       Foreground="White"
                       Background="#33FFFFFF" />
        </StackPanel>
        <StackPanel x:Name="GradeCounts" Orientation="Horizontal" Spacing="22" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="TrophyList" Spacing="6" Margin="0,0,10,0" />
    </ScrollViewer>
  </Grid>
</Window>

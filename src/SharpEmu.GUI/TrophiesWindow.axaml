<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SharpEmu.GUI"
        xmlns:controls="clr-namespace:SharpEmu.GUI.Controls"
        x:Class="SharpEmu.GUI.TrophiesWindow"
        Width="1120"
        Height="840"
        MinWidth="840"
        MinHeight="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#0E0B1A"
        Title="{Binding [Trophies.Title], Source={x:Static local:Localization.Instance}}">
  <Grid>
    <!-- The game's key art, blurred, under an indigo wash that deepens toward the bottom. -->
    <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.5">
      <Image.Effect>
        <BlurEffect Radius="48" />
      </Image.Effect>
    </Image>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#550E0B1A" Offset="0" />
          <GradientStop Color="#D90E0B1A" Offset="0.38" />
          <GradientStop Color="#FA0E0B1A" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border IsHitTestVisible="False">
      <Border.Background>
        <RadialGradientBrush Center="12%,0%" GradientOrigin="12%,0%" RadiusX="70%" RadiusY="60%">
          <GradientStop Color="#447C5CFC" Offset="0" />
          <GradientStop Color="#007C5CFC" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <Grid Margin="44,36,44,24" RowDefinitions="Auto,Auto,*">
      <!-- Hero: cover, name and grade totals, and the completion ring. -->
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="28" Margin="0,0,0,26">
        <Border x:Name="CoverFrame"
                Width="128"
                Height="128"
                CornerRadius="22"
                ClipToBounds="True"
                Background="#22FFFFFF"
                BoxShadow="0 14 32 0 #A0000000">
          <Image x:Name="CoverImage" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
          <TextBlock x:Name="GameNameText"
                     FontSize="32"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="ProgressText" Foreground="#B8B4CC" FontSize="14" />
          <WrapPanel x:Name="GradeCounts" Orientation="Horizontal" Margin="0,6,0,0" />
        </StackPanel>
        <Grid Grid.Column="2" Width="136" Height="136" VerticalAlignment="Center">
          <controls:TrophyProgressRing x:Name="ProgressRing" Thickness="11" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PercentText" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding [Trophies.Completed], Source={x:Static local:Localization.Instance}}"
                       Foreground="#B8B4CC"
                       FontSize="11"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- Filters. -->
      <StackPanel x:Name="FilterBar" Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" />

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="TrophyList" Spacing="10" Margin="0,0,12,12" />
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
